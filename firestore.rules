rules_version = '2';

// Crystal Drops — Firestore Security Rules
// Pattern: customers can place orders anonymously; owner authenticates with Google
// to read/manage everything else.

service cloud.firestore {
  match /databases/{database}/documents {

    // Products — public read so the order page can show prices.
    // Only the owner (authenticated) can edit.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders — customers can CREATE anonymously (placing an order via QR).
    // The required fields lock the shape so abuse is harder.
    // Owner sees and updates everything else.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['customer','items','total','channel','status','createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow read, update, delete: if request.auth != null;
    }

    // Customers — owner only.
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    // Inventory — owner only.
    match /inventory/{itemId} {
      allow read, write: if request.auth != null;
    }

    // Payments — owner only.
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }

    // Staff / delivery routes — owner only.
    match /staff/{staffId} {
      allow read, write: if request.auth != null;
    }

    // Business settings (theme, contact info) — public read, owner write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
